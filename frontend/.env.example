# Frontend Environment Configuration (Next.js)

# Backend API proxy URL (Defaults to http://localhost:5000 if omitted)
# In production, set this to your deployed Express backend URL (e.g. on Render or Railway)
BACKEND_URL=http://localhost:5000

# Optional Direct Public API URL (if bypassing Next.js rewrites)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
